# Copy to .env.local and add your key there. Never put a real key in this file.
# Get a key at https://fastrouter.ai
FASTROUTER_API_KEY=sk-v1-your-key-here
# Optional: override the chat model (defaults to meta-llama/llama-3.1-8b-instruct-turbo)
FASTROUTER_MODEL=
# Optional: override the moderation model (defaults to meta-llama/llama-guard-4-12b)
FASTROUTER_GUARD_MODEL=
